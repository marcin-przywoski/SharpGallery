<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SharpGallery.ViewModels"
             xmlns:md="using:Markdown.Avalonia"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
             x:Class="SharpGallery.Views.UpdateView"
             x:DataType="vm:UpdateViewModel"
             IsVisible="{Binding IsUpdatePanelVisible}">

    <Design.DataContext>
        <vm:UpdateViewModel/>
    </Design.DataContext>

    <Border Background="{DynamicResource BrushSurface1}"
            CornerRadius="10"
            Padding="16"
            Margin="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource BrushBorder}"
            BoxShadow="0 4 16 0 #60000000"
            MaxHeight="450">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
            <!-- Header with dismiss button -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z"
                              Width="20" Height="20"
                              Foreground="{DynamicResource BrushAccent}"/>
                    <TextBlock Text="Update Available"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Dismiss button -->
                <Button Grid.Column="2"
                        Command="{Binding DismissUpdateCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        CornerRadius="4"
                        VerticalAlignment="Top"
                        ToolTip.Tip="Dismiss">
                    <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Width="14" Height="14"
                              Foreground="{DynamicResource BrushTextSecondary}"/>
                </Button>
            </Grid>

            <!-- Version info -->
            <StackPanel Grid.Row="1" Margin="0,8,0,0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding CurrentVersion, StringFormat='v{0}'}"
                               FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="→"
                               FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding NewVersion, StringFormat='v{0}'}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushAccent}"/>
                </StackPanel>
                <TextBlock Text="{Binding ReleaseName}"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           IsVisible="{Binding ReleaseName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Status Message -->
            <TextBlock Grid.Row="2"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Margin="0,8,0,0"
                       Foreground="{DynamicResource BrushTextSecondary}"/>

            <!-- Changelog / Release Notes -->
            <Border Grid.Row="3"
                    Margin="0,8,0,0"
                    Background="#15FFFFFF"
                    CornerRadius="6"
                    Padding="10"
                    IsVisible="{Binding ReleaseNotes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Changelog"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                               <ScrollViewer MaxHeight="180"
                                  VerticalScrollBarVisibility="Auto">
                                    <md:MarkdownScrollViewer Markdown="{Binding ReleaseNotes}"/>                             
                                  </ScrollViewer>

                    <!-- <ScrollViewer MaxHeight="180"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ReleaseNotes}"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   LineHeight="18"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </ScrollViewer> -->
                </StackPanel>
            </Border>

            <!-- Download Progress -->
            <ProgressBar Grid.Row="4"
                         Value="{Binding DownloadProgress}"
                         Maximum="100"
                         IsVisible="{Binding IsDownloading}"
                         Height="6"
                         Margin="0,10,0,0"
                         CornerRadius="3"/>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
                <!-- Download Button -->
                <Button Content="Download Update"
                        Command="{Binding DownloadUpdateCommand}"
                        IsVisible="{Binding IsUpdateAvailable}"
                        IsEnabled="{Binding !IsDownloading}"
                        Classes="accent"
                        CornerRadius="6"
                        Padding="12,8"/>

                <!-- Install Buttons -->
                <Button Content="Install &amp; Restart"
                        Command="{Binding InstallAndRestartCommand}"
                        IsVisible="{Binding IsReadyToInstall}"
                        Classes="accent"
                        CornerRadius="6"
                        Padding="12,8"/>

                <Button Content="Install on Exit"
                        Command="{Binding InstallOnExitCommand}"
                        IsVisible="{Binding IsReadyToInstall}"
                        CornerRadius="6"
                        Padding="12,8"/>
            </StackPanel>

            <!-- Loading Indicator -->
            <ProgressBar Grid.Row="4"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsCheckingForUpdates}"
                         Height="3"
                         Margin="0,10,0,0"
                         CornerRadius="2"/>
        </Grid>
    </Border>
</UserControl>
